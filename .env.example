# ============================================================
# alt-recipe-v2 環境変数サンプル
# コピーして .env.local を作ってください。すべて任意です。
# 何も設定しなくても、ローカルの代替知識ベース＋同梱レシピ＋
# TheMealDB（キー不要）でアプリは完全に動作します。
# ============================================================

# --- 任意: LLMモード（代替案の生成をLLMに任せる） ---
# OPENAI_API_KEY を設定すると /api/substitute がLLMモードになります。
# 未設定の場合はローカルエンジン（知識ベース＋決定的な手順書き換え）で処理します。
# OPENAI_API_KEY=sk-...

# LLMのエンドポイント（OpenAI互換API）。ローカルの llama.cpp サーバー等も指定可能。
# 例: http://localhost:8080/v1 （llama-server のデフォルト）
# LLM_BASE_URL=https://api.openai.com/v1

# 使用モデル名。未設定時は gpt-4o-mini。
# LLM_MODEL=gpt-4o-mini
